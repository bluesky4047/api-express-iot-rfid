PORT=3000
SESSION_SECRET=ganti-dengan-string-acak-panjang
WEB_USERNAME=admin
WEB_PASSWORD=ganti-password-kuat

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=iotserver
MQTT_PASSWORD=aksesiot

# Topik lama
MQTT_TOPIC_CMD=iot/esp32/relay/cmd
MQTT_TOPIC_STATUS=iot/esp32/relay/status

# Topik baru (opsional, ini nilai default-nya)
MQTT_TOPIC_EVENT=iot/esp32/event
MQTT_TOPIC_DOOR=iot/esp32/door/status
MQTT_TOPIC_ONLINE=iot/esp32/online
MQTT_TOPIC_REG_CMD=iot/esp32/register/cmd
MQTT_TOPIC_REG_RESULT=iot/esp32/register/result
MQTT_TOPIC_AUTH_LIST=iot/esp32/auth/list
